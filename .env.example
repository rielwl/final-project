# Copy this file to .env and fill in your key. .env is gitignored: never commit it.
OPENCODE_API_KEY=

# Optional. Defaults live at the top of src/llm.mjs; override them here to
# point at a different OpenAI-compatible provider.
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4.1-flash

# Optional. The assistant listens on 3000 by default.
# PORT=3000

# Optional. When set, the admin dashboard at /admin.html requires this value
# as an x-admin-token header. Leave unset for local single-operator use.
# ADMIN_TOKEN=
